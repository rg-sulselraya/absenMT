PORT=3000
NODE_ENV=development
APP_TIMEZONE=Asia/Makassar
ACTIVE_BRANCH_ID=CAB-HRT

# Credential seed hanya dipakai ketika data/db/store.json belum ada.
SEED_MT_PIN=1234
SEED_ADMIN_PIN=admin123

# Google Apps Script bridge (disarankan untuk pilot)
# URL Web App hasil Deploy > New deployment > Web app.
GOOGLE_APPS_SCRIPT_URL=
# Opsional. Isi jika Script Properties MTA_API_TOKEN digunakan.
GOOGLE_APPS_SCRIPT_TOKEN=

# Fallback opsional jika tidak memakai Apps Script.
# ID diambil dari URL spreadsheet, bukan nama spreadsheet.
GOOGLE_SPREADSHEET_ID=
GOOGLE_SHEETS_TAB=Attendance
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SERVICE_ACCOUNT_JSON=
